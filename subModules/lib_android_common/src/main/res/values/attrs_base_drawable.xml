    <!-- 选中态边框渐变角度 -->
    <attr name="g_selected_border_angle" format="float" />

    <!-- selected 边框渐变中间色位置，范围建议 0 ~ 1，默认 0.5 -->
    <attr name="g_selected_border_center_position" format="float" />



