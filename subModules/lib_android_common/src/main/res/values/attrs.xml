<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="TitleBar">
        <attr name="left_src" format="reference"/>
        <attr name="right_src" format="reference"/>
        <attr name="title_text" format="string"/>
        <attr name="title_text_size" format="float"/>
        <attr name="title_text_color" format="color"/>
        <attr name="right_text" format="string"/>
        <attr name="right_text_size" format="float"/>
        <attr name="right_text_color" format="color"/>
    </declare-styleable>

    <declare-styleable name="ExpandableFlowLayout">
        <attr name="element_divider_horizontal" format="dimension"/>
        <attr name="element_divider_vertical" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="ProcessView">
        <attr name="progressColor" format="reference|color" />
        <attr name="progressWidth" format="dimension" />

        <attr name="backgroundColor" format="reference|color" />
        <attr name="backgroundWidth" format="dimension" />

        <attr name="outerBorderColor" format="reference|color" />
        <attr name="outerBorderWidth" format="dimension" />

        <attr name="cornerRadius" format="dimension" />

        <attr name="startDirection" format="enum">
            <enum name="TOP" value="0" />
            <enum name="RIGHT" value="1" />
            <enum name="BOTTOM" value="2" />
            <enum name="LEFT" value="3" />
        </attr>
    </declare-styleable>

    <declare-styleable name="CircleLoadingView">
        <attr name="circleColor" format="color|reference" />
        <attr name="circleBgColor" format="color|reference" />
        <attr name="strokeWidth" format="dimension" />
    </declare-styleable>
</resources>