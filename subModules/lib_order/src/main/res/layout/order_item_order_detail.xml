<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/order_bg_card"
    android:minHeight="88dp"
    android:padding="12dp">

    <com.android.common.view.base.GImageView
        android:id="@+id/iv_dish_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/order_bg_image_placeholder"
        android:contentDescription="@string/order_detail_image_desc"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="8dp" />

    <TextView
        android:id="@+id/tv_dish_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/textTitle"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_quantity"
        app:layout_constraintStart_toEndOf="@id/iv_dish_image"
        app:layout_constraintTop_toTopOf="@id/iv_dish_image"
        tools:text="番茄炒蛋" />

    <TextView
        android:id="@+id/tv_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/textNormal"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_dish_name"
        tools:text="x2" />

    <TextView
        android:id="@+id/tv_item_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/order_bg_badge"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/color_primary"
        android:textSize="11sp"
        app:layout_constraintStart_toStartOf="@id/tv_dish_name"
        app:layout_constraintTop_toBottomOf="@id/tv_dish_name"
        tools:text="待接受" />

    <LinearLayout
        android:id="@+id/ll_item_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_dish_name"
        app:layout_constraintTop_toBottomOf="@id/tv_item_status" />

</androidx.constraintlayout.widget.ConstraintLayout>
